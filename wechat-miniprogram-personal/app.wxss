page {
  min-height: 100vh;
  background: #fbfaf6;
  color: #16241d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, input, textarea, button, picker {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #8492c1, #aab4d7);
  box-shadow: 0 18rpx 44rpx rgba(98, 112, 168, .18);
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.25;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  color: rgba(255,255,255,.82);
  font-size: 23rpx;
}

.count {
  min-width: 150rpx;
  text-align: right;
}

.count text {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,.78);
}

.count .count-num {
  display: block;
  margin: 8rpx 0 4rpx;
  font-size: 88rpx;
  line-height: .95;
  font-family: Georgia, serif;
  font-weight: 850;
  color: #fff;
}

.grid {
  display: grid;
  gap: 18rpx;
}

.grid.two {
  grid-template-columns: 1fr 1fr;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e0e1da;
  border-radius: 28rpx;
  background: #fffefa;
  box-shadow: 0 8rpx 30rpx rgba(31,45,35,.04);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.card-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.card-head .h3 + .muted {
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

.card-head > .btn {
  flex-shrink: 0;
}

.card-head-main {
  flex: 1;
  min-width: 0;
}

.h2 {
  display: block;
  font-size: 38rpx;
  font-weight: 850;
}

.h3 {
  display: block;
  font-size: 31rpx;
  font-weight: 850;
}

.muted {
  color: #707871;
  font-size: 23rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 28rpx;
  margin: 0;
  border-radius: 18rpx;
  background: #7d89b5;
  color: white;
  font-weight: 750;
  font-size: 27rpx;
  line-height: 1;
  border: 0;
}

.btn::after {
  border: 0;
}

.btn.plain {
  background: #eef1fb;
  color: #59699f;
  border: 2rpx solid #d8def2;
}

.card-action {
  flex: 0 0 184rpx;
  width: 184rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  align-self: center;
}

.card-action:active {
  background: #dfe5f7;
  border-color: #bcc7e8;
}

.btn.warn {
  background: #e58d91;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef0ff;
  color: #6674a6;
  font-size: 21rpx;
  font-weight: 750;
}

.stat {
  min-height: 154rpx;
}

.stat-label {
  display: block;
  color: #707871;
  font-size: 22rpx;
}

.capability-grid {
  gap: 16rpx;
}

.capability-item {
  min-height: 132rpx;
  padding: 22rpx;
  border: 2rpx solid #e1e5f1;
  border-radius: 20rpx;
  background: #fafbff;
}

.capability-item .stat-label {
  margin-bottom: 8rpx;
  color: #344058;
  font-size: 25rpx;
  font-weight: 800;
}

.stat-num {
  display: block;
  margin-top: 8rpx;
  color: #6573a4;
  font-size: 48rpx;
  font-weight: 850;
  font-family: Georgia, serif;
}

.progress {
  height: 12rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7e8e1;
}

.bar {
  display: block;
  height: 100%;
  border-radius: 999rpx;
  background: #96a1c7;
}

.goal-strip {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.goal-card {
  flex: 0 0 250rpx;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 3rpx solid currentColor;
  border-radius: 28rpx;
  background: white;
  color: #7fa4d8;
}

.goal-card.green { color: #79b99a; }
.goal-card.orange { color: #e7ae76; }
.goal-card.purple { color: #9a8bc5; }
.goal-card.red { color: #e58d91; }

.goal-name {
  color: #16241d;
  font-size: 31rpx;
  font-weight: 850;
}

.goal-meta {
  display: block;
  margin-top: 10rpx;
  color: #677068;
  line-height: 1.7;
}

.goal-status {
  width: 78%;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ececf1;
  font-weight: 750;
}

.task {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ecece6;
}

.task:last-child {
  border-bottom: 0;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  font-weight: 800;
  font-size: 29rpx;
}

.task-meta {
  display: block;
  margin-top: 6rpx;
  color: #707871;
  font-size: 23rpx;
}

.done {
  opacity: .5;
  text-decoration: line-through;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.field {
  display: grid;
  gap: 0;
}

.form > .field,
.form > .grid {
  margin-bottom: 0;
}

.form > .grid .field {
  margin-bottom: 0;
}

.label {
  min-height: 48rpx;
  margin-bottom: 0;
  display: flex;
  align-items: center;
  color: #303932;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 36rpx;
}

input, textarea, picker {
  width: 100%;
  min-height: 92rpx;
  padding: 0 28rpx;
  border: 2rpx solid #dfe2dc;
  border-radius: 18rpx;
  background: #fff;
}

input {
  height: 92rpx;
  line-height: 92rpx;
}

picker {
  height: 92rpx;
}

.picker {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  line-height: 1.4;
}

input:focus,
textarea:focus {
  border-color: #aeb9dc;
  background: #fdfdff;
}

textarea {
  min-height: 200rpx;
  padding: 28rpx;
  line-height: 1.55;
}

.form > .btn {
  width: auto;
  align-self: stretch;
  margin: 24rpx 0 0;
}

.form-action {
  display: flex;
  justify-content: center;
  width: 100%;
  padding-top: 28rpx;
}

.form-action .btn {
  width: 520rpx;
  max-width: 100%;
  margin: 0;
}

.form-card {
  padding: 26rpx 32rpx 32rpx;
}

.empty {
  padding: 54rpx 20rpx;
  text-align: center;
  color: #707871;
}

.section-title {
  padding: 26rpx 6rpx 20rpx;
}

.section-title .h2 {
  margin-bottom: 10rpx;
  line-height: 1.25;
}

.section-title .muted {
  display: block;
  line-height: 1.55;
}

.switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #f0f1f6;
}

.switch button {
  min-height: 64rpx;
  border-radius: 16rpx;
  background: transparent;
  color: #707871;
  font-size: 25rpx;
}

.switch button.active {
  background: white;
  color: #6573a4;
  font-weight: 800;
}
