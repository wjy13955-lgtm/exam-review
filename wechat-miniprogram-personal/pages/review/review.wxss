.picker {
  min-height: 88rpx;
  line-height: 1.4;
}

.page > .card > .form {
  margin-top: 4rpx;
}

.mistake-photo {
  width: 100%;
  height: 260rpx;
  margin-bottom: 22rpx;
  border-radius: 22rpx;
  background: #f0f1f6;
}

.review-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ecece6;
}

.review-card:last-child {
  border-bottom: 0;
}

.thumb {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 20rpx;
  background: #f0f1f6;
}

.review-main {
  flex: 1;
  min-width: 0;
}

.mini {
  min-width: 112rpx;
  min-height: 62rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.vocab-card {
  border-color: #ece3d2;
  background: linear-gradient(135deg, #fffefa, #fff8ee);
}

.vocab-review-card {
  align-items: flex-start;
}

.review-mask {
  position: fixed;
  z-index: 99;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(12, 20, 16, .42);
}

.review-dialog {
  width: 100%;
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx;
  background: #fffefa;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, .16);
}

.review-dialog::after {
  content: "";
  display: block;
  height: 18rpx;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 50%;
  background: #f0f1f6;
  color: #6674a6;
  font-size: 36rpx;
  line-height: 60rpx;
}

.quiz-box {
  display: grid;
  gap: 14rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f5ef;
}

.quiz-kicker {
  color: #7d89b5;
  font-size: 23rpx;
  font-weight: 800;
}

.quiz-title {
  color: #16241d;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.quiz-sub {
  color: #667068;
  font-size: 25rpx;
}

.recall-prompts {
  display: grid;
  gap: 8rpx;
  margin-top: 8rpx;
  color: #667068;
  font-size: 25rpx;
  line-height: 1.55;
}

.choice-question {
  display: grid;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fffefa;
}

.choice-stem {
  color: #26332b;
  font-size: 27rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.choice-options {
  display: grid;
  gap: 12rpx;
}

.choice-option {
  display: grid;
  grid-template-columns: 44rpx 1fr;
  gap: 12rpx;
  align-items: flex-start;
  padding: 16rpx;
  border: 1rpx solid #e5e2d8;
  border-radius: 18rpx;
  background: white;
  color: #26332b;
  font-size: 26rpx;
  line-height: 1.5;
}

.choice-option text:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eef0ff;
  color: #6674a6;
  font-weight: 900;
}

.answer-btn {
  width: 100%;
  margin-top: 22rpx;
}

.answer-box {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e2d8;
  border-radius: 24rpx;
  background: #fff;
}

.answer-line {
  color: #26332b;
  font-size: 26rpx;
  line-height: 1.55;
}

.review-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
  padding-bottom: 8rpx;
}

.review-actions .btn {
  width: 100%;
  min-width: 0;
  min-height: 84rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 27rpx;
  line-height: 1.2;
}
