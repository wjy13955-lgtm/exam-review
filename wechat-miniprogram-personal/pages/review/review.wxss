.picker {
  min-height: 88rpx;
  line-height: 1.4;
}

.page > .card > .form {
  margin-top: 4rpx;
}

.mistake-photo {
  width: 100%;
  height: 260rpx;
  margin-bottom: 22rpx;
  border-radius: 22rpx;
  background: #f0f1f6;
}

.review-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ecece6;
}

.review-card:last-child {
  border-bottom: 0;
}

.thumb {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 20rpx;
  background: #f0f1f6;
}

.review-main {
  flex: 1;
  min-width: 0;
}

.mini {
  min-width: 112rpx;
  min-height: 62rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.vocab-card {
  border-color: #ece3d2;
  background: linear-gradient(135deg, #fffefa, #fff8ee);
}

.vocab-review-card {
  align-items: flex-start;
}
