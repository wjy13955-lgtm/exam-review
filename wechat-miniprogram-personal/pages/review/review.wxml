<view class="page">
  <view class="section-title">
    <text class="h2">错题复盘</text>
    <text class="muted">拍照留索引，按遗忘曲线自动安排复盘</text>
  </view>

  <view class="grid two">
    <view class="card stat"><text class="stat-label">今日到期</text><text class="stat-num">{{dueList.length}}</text></view>
    <view class="card stat"><text class="stat-label">已掌握</text><text class="stat-num">{{masteredList.length}}</text></view>
  </view>

  <view class="card form-card vocab-card">
    <view class="card-head">
      <view>
        <text class="h3">成语词义积累 / 辨析</text>
        <text class="muted">言语理解高频易混词，按遗忘曲线复盘</text>
      </view>
      <text class="pill">0/1/3/7/15/30</text>
    </view>

    <form class="form" bindsubmit="submitVocab">
      <view class="grid two">
        <view class="field"><text class="label">成语/实词</text><input name="word" placeholder="例如：不孚众望" /></view>
        <view class="field"><text class="label">易混词</text><input name="confuseWith" placeholder="例如：不负众望" /></view>
      </view>
      <view class="field"><text class="label">词义</text><textarea name="meaning" placeholder="写清准确含义，避免只凭字面理解" /></view>
      <view class="field"><text class="label">辨析要点</text><textarea name="difference" placeholder="两者差异、感情色彩、适用对象、语义轻重" /></view>
      <view class="field"><text class="label">适用语境</text><input name="context" placeholder="例如：评价是否令人信服 / 是否辜负期待" /></view>
      <view class="field"><text class="label">例句/错例</text><textarea name="example" placeholder="可写一道逻辑填空里的语境句" /></view>
      <view class="field"><text class="label">来源</text><input name="source" placeholder="例如：粉笔言语第 3 组 / 模考错题" /></view>
      <view class="form-action"><button class="btn" formType="submit">保存词条并生成复盘计划</button></view>
    </form>
  </view>

  <view class="card">
    <view class="card-head">
      <view><text class="h3">今日词义复盘</text><text class="muted">看词义、辨析点和语境，确认是否真正掌握</text></view>
      <text class="pill">{{vocabDueList.length}} 项</text>
    </view>
    <block wx:if="{{vocabDueList.length}}">
      <view wx:for="{{vocabDueList}}" wx:key="id" class="review-card vocab-review-card">
        <view class="review-main">
          <text class="task-title">{{item.word}}</text>
          <text class="task-meta">易混：{{item.confuseWith || '无'}} · 第 {{item.nextRound}} / 6 轮</text>
          <text class="task-meta">辨析：{{item.difference || item.meaning || '待补充'}}</text>
        </view>
        <button class="btn plain mini" data-id="{{item.id}}" data-type="vocab" bindtap="startReview">复盘</button>
      </view>
    </block>
    <view wx:else class="empty">今天没有到期词义复盘</view>
  </view>

  <view class="card form-card">
    <view class="card-head">
      <view>
        <text class="h3">添加错题</text>
        <text class="muted">第二版先支持拍照/上传，OCR 自动识别后续接入</text>
      </view>
      <button class="btn plain" bindtap="chooseImage">拍照/上传</button>
    </view>

    <image wx:if="{{imagePath}}" class="mistake-photo" src="{{imagePath}}" mode="aspectFill" bindtap="previewImage" />

    <form class="form" bindsubmit="submit">
      <view class="field">
        <text class="label">模块</text>
        <picker range="{{modules}}" value="{{moduleIndex}}" bindchange="changeModule">
          <view class="picker">{{modules[moduleIndex]}}</view>
        </picker>
      </view>
      <view class="field"><text class="label">来源/题号</text><input name="source" placeholder="粉笔 · 第12题" /></view>
      <view class="field"><text class="label">题目摘要</text><input name="summary" placeholder="用一句话描述考点" /></view>
      <view class="field"><text class="label">题干文字</text><textarea name="questionText" placeholder="可手动粘贴识别出的题干；后续可接 OCR 自动填充" /></view>
      <view class="field"><text class="label">错误知识点</text><input name="knowledge" placeholder="例如：增长率比较 / 削弱加强 / 排列组合" /></view>
      <view class="field">
        <text class="label">错误原因</text>
        <picker range="{{reasons}}" value="{{reasonIndex}}" bindchange="changeReason">
          <view class="picker">{{reasons[reasonIndex]}}</view>
        </picker>
      </view>
      <view class="field"><text class="label">正确思路</text><textarea name="solution" placeholder="下次看到什么特征，就用什么方法？" /></view>
      <view class="form-action"><button class="btn" formType="submit">保存并生成复盘计划</button></view>
    </form>
  </view>

  <view class="card">
    <view class="card-head">
      <view><text class="h3">今日到期复盘</text><text class="muted">完成后自动进入下一轮</text></view>
      <text class="pill">{{dueList.length}} 项</text>
    </view>
    <block wx:if="{{dueList.length}}">
      <view wx:for="{{dueList}}" wx:key="id" class="review-card">
        <image wx:if="{{item.imagePath}}" class="thumb" src="{{item.imagePath}}" mode="aspectFill" data-src="{{item.imagePath}}" bindtap="previewListImage" />
        <view class="review-main">
          <text class="task-title">{{item.summary}}</text>
          <text class="task-meta">{{item.module}} · {{item.knowledge || item.reason}}</text>
          <text class="task-meta">第 {{item.nextRound}} / 6 轮 · 到期 {{item.reviewDate}}</text>
        </view>
        <button class="btn plain mini" data-id="{{item.id}}" data-type="mistake" bindtap="startReview">复盘</button>
      </view>
    </block>
    <view wx:else class="empty">今天没有到期错题</view>
  </view>

  <view class="card">
    <view class="card-head">
      <view><text class="h3">未来词义复盘</text><text class="muted">适合成语辨析、实词辨析、固定搭配积累</text></view>
      <text class="pill">{{vocabFutureList.length}} 项</text>
    </view>
    <block wx:if="{{vocabFutureList.length}}">
      <view wx:for="{{vocabFutureList}}" wx:key="id" class="task">
        <view class="task-main">
          <text class="task-title">{{item.word}}</text>
          <text class="task-meta">易混：{{item.confuseWith || '无'}} · 下次 {{item.reviewDate}}</text>
        </view>
        <text class="pill">第 {{item.nextRound}} 轮</text>
      </view>
    </block>
    <view wx:else class="empty">暂无未来词义复盘</view>
  </view>

  <view class="card">
    <view class="card-head">
      <view><text class="h3">未来复盘</text><text class="muted">按 0/1/3/7/15/30 天安排</text></view>
      <text class="pill">{{futureList.length}} 项</text>
    </view>
    <block wx:if="{{futureList.length}}">
      <view wx:for="{{futureList}}" wx:key="id" class="task">
        <view class="task-main">
          <text class="task-title">{{item.summary}}</text>
          <text class="task-meta">{{item.module}} · {{item.knowledge || item.reason}} · 下次 {{item.reviewDate}}</text>
        </view>
        <text class="pill">第 {{item.nextRound}} 轮</text>
      </view>
    </block>
    <view wx:else class="empty">暂无未来复盘</view>
  </view>

  <view class="card">
    <view class="card-head">
      <view><text class="h3">已掌握</text><text class="muted">完成 6 轮后进入这里</text></view>
      <text class="pill">{{masteredList.length}} 项</text>
    </view>
    <block wx:if="{{masteredList.length}}">
      <view wx:for="{{masteredList}}" wx:key="id" class="task">
        <view class="task-main">
          <text class="task-title done">{{item.summary}}</text>
          <text class="task-meta">{{item.module}} · {{item.knowledge || item.reason}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">还没有完成全部复盘的错题</view>
  </view>

  <view class="card">
    <view class="card-head">
      <view><text class="h3">已掌握词条</text><text class="muted">完成 6 轮词义辨析后进入这里</text></view>
      <text class="pill">{{vocabMasteredList.length}} 项</text>
    </view>
    <block wx:if="{{vocabMasteredList.length}}">
      <view wx:for="{{vocabMasteredList}}" wx:key="id" class="task">
        <view class="task-main">
          <text class="task-title done">{{item.word}}</text>
          <text class="task-meta">{{item.meaning || item.difference || '已掌握'}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">还没有完成全部复盘的词条</view>
  </view>

  <view wx:if="{{activeReview}}" class="review-mask" bindtap="closeReviewCard">
    <view class="review-dialog" catchtap="noop">
      <view class="card-head">
        <view>
          <text class="h3">{{activeReview.type === 'vocab' ? '词义自测' : '错题自测'}}</text>
          <text class="muted">先回忆，再看答案，最后选择掌握程度</text>
        </view>
        <button class="close-btn" bindtap="closeReviewCard">×</button>
      </view>

      <view wx:if="{{activeReview.type === 'vocab'}}" class="quiz-box">
        <text class="quiz-kicker">先只看词语和易混词</text>
        <text class="quiz-title">{{activeReview.word}}</text>
        <text class="quiz-sub">易混：{{activeReview.confuseWith || '无'}}</text>
        <view class="recall-prompts">
          <text>请先在心里回答：</text>
          <text>1. 这个词是什么意思？</text>
          <text>2. 和易混词差在哪里？</text>
          <text>3. 适合什么语境？</text>
        </view>
      </view>

      <view wx:else class="quiz-box">
        <text class="quiz-kicker">先只看题目线索</text>
        <image wx:if="{{activeReview.imagePath}}" class="mistake-photo" src="{{activeReview.imagePath}}" mode="aspectFill" />
        <text class="quiz-title">{{activeReview.summary}}</text>
        <text class="quiz-sub">{{activeReview.module}} · {{activeReview.source}}</text>
        <view class="recall-prompts">
          <text>请先在心里回答：</text>
          <text>1. 这题考什么知识点？</text>
          <text>2. 我当时为什么错？</text>
          <text>3. 下次第一步应该怎么做？</text>
        </view>
      </view>

      <button wx:if="{{!showAnswer}}" class="btn answer-btn" bindtap="showReviewAnswer">查看答案 / 核对思路</button>

      <view wx:if="{{showAnswer && activeReview.type === 'vocab'}}" class="answer-box">
        <text class="answer-line">词义：{{activeReview.meaning || '待补充'}}</text>
        <text class="answer-line">辨析：{{activeReview.difference || '待补充'}}</text>
        <text class="answer-line">语境：{{activeReview.context || '待补充'}}</text>
        <text class="answer-line">例句：{{activeReview.example || '待补充'}}</text>
      </view>

      <view wx:if="{{showAnswer && activeReview.type === 'mistake'}}" class="answer-box">
        <text class="answer-line">知识点：{{activeReview.knowledge || '待补充'}}</text>
        <text class="answer-line">错因：{{activeReview.reason || '待补充'}}</text>
        <text class="answer-line">正确思路：{{activeReview.solution || '待补充'}}</text>
        <text class="answer-line">题干文字：{{activeReview.questionText || '未记录'}}</text>
      </view>

      <view wx:if="{{showAnswer}}" class="review-actions">
        <button class="btn plain" data-level="forgot" bindtap="markReviewResult">没想起</button>
        <button class="btn plain" data-level="vague" bindtap="markReviewResult">模糊</button>
        <button class="btn" data-level="mastered" bindtap="markReviewResult">掌握</button>
      </view>
    </view>
  </view>
</view>
