<view class="page">
  <view class="hero">
    <view>
      <text class="muted">个人版 · {{profile.exam}}主线</text>
      <text class="hero-title">{{profile.name ? profile.name + '，' : ''}}今天也向目标靠近一点</text>
      <text class="hero-sub">{{profile.examDate}} 笔试 · {{profile.province || '目标地区待设置'}} · 目标 {{targetScore}} 分</text>
    </view>
    <view class="count">
      <text>倒计时</text>
      <text class="count-num">{{stats.left}}</text>
      <text>天</text>
    </view>
  </view>

  <view class="grid two">
    <view class="card stat">
      <text class="stat-label">今日完成</text>
      <view class="dashboard-stat-line"><text class="stat-num">{{stats.todayRate}}%</text></view>
      <view class="progress"><view class="bar" style="width: {{stats.todayRate}}%;"></view></view>
    </view>
    <view class="card stat">
      <text class="stat-label">今日用时</text>
      <view class="dashboard-stat-line">
        <text class="stat-num">{{stats.doneMinutes}}</text>
        <text class="stat-suffix">/ {{stats.todayMinutes}} 分钟</text>
      </view>
      <view class="progress"><view class="bar" style="width: {{timeRate}}%;"></view></view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <view class="card-head-main">
        <text class="h3">五大模块今日目标</text>
        <text class="muted">题量 · 正确率 · 完成时间</text>
      </view>
      <text class="pill">可调整</text>
    </view>
    <view class="goal-strip">
      <view wx:for="{{goals}}" wx:key="module" class="goal-card {{item.color}}">
        <text class="goal-name">{{item.module}}</text>
        <text class="goal-meta">{{item.questions}} 题</text>
        <text class="goal-meta">目标 {{item.accuracy}}%</text>
        <text class="goal-meta">≤ {{item.minutes}} 分钟</text>
        <text class="goal-status">{{item.actualText}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <view class="card-head-main">
        <text class="h3">今日任务</text>
        <text class="muted">按计划逐项完成</text>
      </view>
      <button class="btn plain card-action" bindtap="goPlan">查看计划</button>
    </view>
    <block wx:if="{{todayTasks.length}}">
      <view wx:for="{{todayTasks}}" wx:key="id" class="task">
        <checkbox checked="{{item.done}}" data-id="{{item.id}}" bindtap="toggleTask" />
        <view class="task-main">
          <text class="task-title {{item.done ? 'done' : ''}}">{{item.title}}</text>
          <text class="task-meta">{{item.module}} · {{item.minutes}} 分钟</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">今天暂时没有任务</view>
  </view>

  <view class="card">
    <view class="card-head">
      <view class="card-head-main">
        <text class="h3">今日到期复盘</text>
        <text class="muted">按遗忘曲线安排，完成后进入下一轮</text>
      </view>
      <button class="btn plain card-action" bindtap="goReview">去复盘</button>
    </view>
    <block wx:if="{{dueMistakes.length || dueVocabs.length}}">
      <view wx:for="{{dueMistakes}}" wx:key="id" class="task">
        <view class="task-main">
          <text class="task-title">{{item.summary}}</text>
          <text class="task-meta">{{item.module}} · {{item.knowledge || item.reason}} · 第 {{item.nextRound}} / 6 轮</text>
        </view>
        <text class="pill">{{item.reviewDate}}</text>
      </view>
      <view wx:for="{{dueVocabs}}" wx:key="id" class="task">
        <view class="task-main">
          <text class="task-title">{{item.word}}</text>
          <text class="task-meta">词义辨析 · 易混 {{item.confuseWith || '无'}} · 第 {{item.nextRound}} / 6 轮</text>
        </view>
        <text class="pill">{{item.reviewDate}}</text>
      </view>
    </block>
    <view wx:else class="empty">今天没有到期错题</view>
  </view>

  <view class="card">
    <view class="card-head">
      <view class="card-head-main">
        <text class="h3">个人版能力规划</text>
        <text class="muted">先做好自用记录，数据保存在本机</text>
      </view>
      <button class="btn plain card-action" bindtap="goSettings">设置</button>
    </view>
    <view class="grid two capability-grid">
      <view class="stat capability-item"><text class="stat-label">本地备份</text><text class="muted">设置页可导出/恢复</text></view>
      <view class="stat capability-item"><text class="stat-label">学习报告</text><text class="muted">后续按记录生成</text></view>
      <view class="stat capability-item"><text class="stat-label">错题复盘</text><text class="muted">拍照索引 + 遗忘曲线</text></view>
      <view class="stat capability-item"><text class="stat-label">词义积累</text><text class="muted">成语辨析 + 间隔复习</text></view>
      <view class="stat capability-item"><text class="stat-label">模考趋势</text><text class="muted">对比目标分数</text></view>
    </view>
  </view>
</view>
