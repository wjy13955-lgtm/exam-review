<view class="page">
  <view class="section-title">
    <text class="h2">设置</text>
    <text class="muted">个人版：数据保存在当前微信本机缓存</text>
  </view>

  <view class="card">
    <form class="form" bindsubmit="saveProfile">
      <view class="grid two">
        <view class="field"><text class="label">称呼</text><input name="name" value="{{profile.name}}" placeholder="可选" /></view>
        <view class="field"><text class="label">考试</text><input name="exam" value="{{profile.exam}}" /></view>
      </view>
      <view class="field"><text class="label">目标地区</text><input name="province" value="{{profile.province}}" placeholder="例如：江苏" /></view>
      <view class="field"><text class="label">考试日期</text><input name="examDate" value="{{profile.examDate}}" placeholder="YYYY-MM-DD" /></view>
      <view class="grid two">
        <view class="field"><text class="label">行测目标</text><input name="targetXingce" type="digit" value="{{profile.targetXingce}}" /></view>
        <view class="field"><text class="label">申论目标</text><input name="targetShenlun" type="digit" value="{{profile.targetShenlun}}" /></view>
      </view>
      <view class="grid two">
        <view class="field"><text class="label">工作日分钟</text><input name="weekday" type="number" value="{{profile.weekday}}" /></view>
        <view class="field"><text class="label">周末分钟</text><input name="weekend" type="number" value="{{profile.weekend}}" /></view>
      </view>
      <button class="btn" formType="submit">保存目标</button>
    </form>
  </view>

  <view class="card">
    <view class="card-head">
      <view>
        <text class="h3">数据与备份</text>
        <text class="muted">不接云同步，先用手动备份</text>
      </view>
    </view>
    <button class="btn plain" bindtap="exportData">导出备份到剪贴板</button>
    <button class="btn plain gap" bindtap="importData">从剪贴板恢复备份</button>
    <button class="btn plain gap" bindtap="regenerate">重新生成计划</button>
    <button class="btn warn gap" bindtap="reset">清空数据</button>
  </view>
</view>
